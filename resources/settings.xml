<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings version="1">
  <section id="plugin.audio.koshelf">
    <category id="playback" label="30000" help="30001">
      <group id="1">
        <setting id="player" type="integer" label="30160" help="30161">
          <level>0</level>
          <default>0</default>
          <constraints>
            <options>
              <option label="30162">0</option>
              <option label="30163">1</option>
            </options>
          </constraints>
          <control type="spinner" format="string"/>
        </setting>
        <setting id="speed_step" type="string" label="30010" help="30011">
          <level>0</level>
          <default>0.10</default>
          <constraints>
            <options>
              <option label="30090">0.05</option>
              <option label="30091">0.10</option>
              <option label="30092">0.15</option>
              <option label="30093">0.20</option>
              <option label="30094">0.25</option>
            </options>
          </constraints>
          <control type="spinner" format="string"/>
        </setting>
        <setting id="min_speed" type="number" label="30020" help="30021">
          <level>0</level>
          <default>1.0</default>
          <constraints>
            <minimum>0.5</minimum>
            <step>0.05</step>
            <maximum>1.0</maximum>
          </constraints>
          <control type="slider" format="number">
            <format>{:.2f}x</format>
          </control>
        </setting>
        <setting id="max_speed" type="number" label="30030" help="30031">
          <level>0</level>
          <default>3.0</default>
          <constraints>
            <minimum>1.0</minimum>
            <step>0.05</step>
            <maximum>5.0</maximum>
          </constraints>
          <control type="slider" format="number">
            <format>{:.2f}x</format>
          </control>
        </setting>
        <setting id="book_speed" type="number" label="30040" help="30041">
          <level>0</level>
          <default>1.0</default>
          <constraints>
            <minimum>0.5</minimum>
            <step>0.05</step>
            <maximum>5.0</maximum>
          </constraints>
          <control type="slider" format="number">
            <format>{:.2f}x</format>
          </control>
        </setting>
        <setting id="podcast_speed" type="number" label="30050" help="30051">
          <level>0</level>
          <default>1.0</default>
          <constraints>
            <minimum>0.5</minimum>
            <step>0.05</step>
            <maximum>5.0</maximum>
          </constraints>
          <control type="slider" format="number">
            <format>{:.2f}x</format>
          </control>
        </setting>
        <setting id="per_book_speed" type="boolean" label="30060" help="30061">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>
    <category id="sleep" label="30200" help="30201">
      <group id="1">
        <setting id="sleep_dim_screen" type="boolean" label="30210" help="30211">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="sleep_idle_seconds" type="integer" label="30220" help="30221">
          <level>0</level>
          <default>30</default>
          <constraints>
            <minimum>5</minimum>
            <step>5</step>
            <maximum>300</maximum>
          </constraints>
          <control type="slider" format="integer">
            <format>{} seconds</format>
          </control>
          <dependencies>
            <dependency type="visible">
              <condition setting="sleep_dim_screen">true</condition>
            </dependency>
          </dependencies>
        </setting>
        <setting id="sleep_screensaver_mode" type="string" label="30230" help="30231">
          <level>0</level>
          <default>screensaver.xbmc.builtin.black</default>
          <constraints>
            <options>
              <option label="30232">screensaver.xbmc.builtin.black</option>
              <option label="30233">screensaver.xbmc.builtin.dim</option>
            </options>
          </constraints>
          <control type="spinner" format="string"/>
          <dependencies>
            <dependency type="visible">
              <condition setting="sleep_dim_screen">true</condition>
            </dependency>
          </dependencies>
        </setting>
        <setting id="sleep_rampdown_seconds" type="integer" label="30250" help="30251">
          <level>0</level>
          <default>30</default>
          <constraints>
            <minimum>0</minimum>
            <step>5</step>
            <maximum>120</maximum>
          </constraints>
          <control type="slider" format="integer">
            <format>{} seconds</format>
          </control>
        </setting>
        <setting id="sleep_display_off" type="boolean" label="30240" help="30241">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="sleep_last_preset" type="integer">
          <level>0</level>
          <default>30</default>
          <visible>false</visible>
        </setting>
      </group>
    </category>
    <category id="general" label="30100" help="30101">
